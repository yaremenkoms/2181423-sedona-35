{
 "duration": 40.44,
 "phrases": [
  {
   "start": 0.0,
   "end": 4.23,
   "text": "В этом видео вы узнаете как отправить работу на проверку с телефона.",
   "speech_start": 0.0
  },
  {
   "start": 4.23,
   "end": 8.65,
   "text": "Откройте в приложении Дневник Мэш урок, на котором выполняли работу.",
   "speech_start": 4.51
  },
  {
   "start": 8.65,
   "end": 11.04,
   "text": "Нажмите прикрепить файл.",
   "speech_start": 9.09
  },
  {
   "start": 11.04,
   "end": 16.31,
   "text": "Работу можно загрузить во время урока и в течение 5 минут после его завершения.",
   "speech_start": 11.37
  },
  {
   "start": 16.31,
   "end": 18.29,
   "text": "Нажмите «Загрузить».",
   "speech_start": 16.71
  },
  {
   "start": 18.29,
   "end": 20.55,
   "text": "Вы берите \"Сделать снимок\"",
   "speech_start": 18.71
  },
  {
   "start": 20.55,
   "end": 22.34,
   "text": "и сфотографируйте работу.",
   "speech_start": 20.78
  },
  {
   "start": 22.34,
   "end": 27.32,
   "text": "Если страниц несколько, снова нажмите «загрузить» и сфотографируйте следующую.",
   "speech_start": 22.73
  },
  {
   "start": 27.32,
   "end": 30.16,
   "text": "Можно прикрепить до 10 фотографий.",
   "speech_start": 27.8
  },
  {
   "start": 30.16,
   "end": 33.29,
