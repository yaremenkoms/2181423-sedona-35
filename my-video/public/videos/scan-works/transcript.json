{
 "duration": 61.973,
 "phrases": [
  {
   "start": 0.0,
   "end": 6.92,
   "text": "В этом видео вы узнаете, как учителю смобильного телефона загрузить скан работы обучающегося в риэстр фоторабот.",
   "speech_start": 0.0
  },
  {
   "start": 6.92,
   "end": 9.46,
   "text": "Проверить работу и выставить отметку.",
   "speech_start": 7.13
  },
  {
   "start": 9.46,
   "end": 12.3,
   "text": "Для этого откройте урок в расписании",
   "speech_start": 9.78
  },
  {
   "start": 12.3,
   "end": 14.51,
   "text": "и нажмите на значок \"I\".",
   "speech_start": 12.73
  },
  {
   "start": 14.51,
   "end": 16.65,
   "text": "Откройте карточку урока.",
   "speech_start": 14.92
  },
  {
   "start": 16.65,
   "end": 19.09,
   "text": "Нажмите \"перейти в риэстер",
   "speech_start": 17.05
  },
  {
   "start": 19.09,
   "end": 21.98,
   "text": "Данные урока подставятся автоматически.",
   "speech_start": 19.52
  },
  {
   "start": 21.98,
   "end": 25.18,
   "text": "Найдите ученика и нажмите прикрепить.",
   "speech_start": 22.4
  },
  {
   "start": 25.18,
   "end": 29.13,
   "text": "Нажмите «Добавить файл» и выберите, как добавить работу.",
   "speech_start": 25.64
  },
  {
   "start": 29.13,
   "end": 30.39,
   "text": "Сделать фото.",
   "speech_start": 29.32
  },
  {
   "start": 30.39,
   "end": 31.96,
   "text": "Прикрепитесь галереей",
   "speech_start": 30.66
  },
  {
   "start": 31.96,
   "end": 33.27,
   "text": "или из файлов.",
   "speech_start": 32.22
  },
  {
   "start": 33.27,
   "end": 38.07,
   "text": "После загрузки скан работы будет добавлен в реестр автоматически.",
   "speech_start": 33.67
  },
  {
   "start": 38.07,
   "end": 42.07,
   "text": "Чтобы проверить работу, нажмите \"перейти к проверке\".",
   "speech_start": 38.74
  },
  {
   "start": 42.07,
   "end": 45.74,
   "text": "Оставьте пометки прямо на фото и нажмите на галочку.",
   "speech_start": 42.47
  },
  {
   "start": 45.74,
   "end": 49.54,
   "text": "Чтобы выставить отметку, нажмите на поле «Отметка».",
   "speech_start": 46.23
  },
  {
   "start": 49.54,
   "end": 52.33,
   "text": "Выберите форму контроля и отметку.",
   "speech_start": 49.97
  },
  {
   "start": 52.33,
   "end": 54.61,
   "text": "Затем нажмите \"сохранить\".",
   "speech_start": 52.73
  },
  {
   "start": 54.61,
   "end": 55.69,
   "text": "Готово!",
   "speech_start": 55.07
  },
  {
   "start": 55.69,
   "end": 60.36,
   "text": "Отметка, выставленная в риэстре, автоматически попадет в электронный журнал.",
   "speech_start": 55.87
  },
  {
   "start": 60.36,
